 static void
 peer_dump_done(void *ptr, uint8_t aid)
 {
+	struct rde_peer *peer = ptr;
+
+	if (peer->dump_count == 0)
+		fatalx("%s: unbalanced dump", __func__);
+	if (--peer->dump_count == 0 && peer->dump_admitted) {
+		if (dump_active == 0)
+			fatalx("%s: unbalanced admission", __func__);
+		dump_active--;
+		peer->dump_admitted = 0;
+	}
+
 	peer_blast_done(ptr, aid);
+}
+
+/*
+ * An admitted initial dump must finish: its peer cannot drain Pending until
+ * done. Bound concurrent dumps, retaining the RIB walker's batching. Under
+ * pressure, admit a batch only if no active dump or non-dumping peer can drain.
+ */
+static int
+peer_dump_throttled(void *arg)
+{
+	struct rde_peer *peer = arg, *p;
+
+	if (peer->dump_admitted)
+		return 0;
+	if (dump_active >= RDE_PENDING_DUMPS)
+		return 1;
+	if (peer_pending_throttled(NULL)) {
+		if (dump_active != 0)
+			return 1;
+		RB_FOREACH(p, peer_tree, &peertable) {
+			if (peer_is_up(p) && p->dump_count == 0 &&
+			    (p->stats.pending_update != 0 ||
+			    p->stats.pending_withdraw != 0))
+				return 1;
+		}
+	}
+	/* Reserve a batch before any walker can fill the Pending headroom. */
+	RB_FOREACH(p, peer_tree, &peertable) {
+		if (!peer_is_up(p) || p->dump_count == 0 || p->dump_admitted)
+			continue;
+		p->dump_admitted = 1;
+		if (++dump_active >= RDE_PENDING_DUMPS)
+			break;
+	}
+	return !peer->dump_admitted;
 }
 
