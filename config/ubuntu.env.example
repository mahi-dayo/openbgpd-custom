# Source via RS_TEST_CONFIG from the Ubuntu lab controller.
: "${OPENBGPD_CUSTOM_PREFIX:?set OPENBGPD_CUSTOM_PREFIX to the Portable build directory}"
openbgpd_custom_lab_config=${OPENBGPD_CUSTOM_LAB_CONFIG:-"$HOME/openbgpd-rs-lab/rs-test.env"}
if [[ -r "$openbgpd_custom_lab_config" ]]; then
    source "$openbgpd_custom_lab_config"
fi
unset openbgpd_custom_lab_config

openbgpd_custom_metadata="$OPENBGPD_CUSTOM_PREFIX/BUILD-METADATA.txt"
if [[ "$OPENBGPD_CUSTOM_PREFIX" != /* ||
      ! -x "$OPENBGPD_CUSTOM_PREFIX/sbin/bgpd" ||
      ! -x "$OPENBGPD_CUSTOM_PREFIX/sbin/bgpctl" ||
      ! -r "$openbgpd_custom_metadata" ]]; then
    printf 'ERROR: Ubuntu preset requires a Portable build and an absolute prefix\n' >&2
    return 1
fi
PORTABLE93_OPENBGPD_VERSION=$(awk -F= '$1 == "OpenBGPD_Version" {print $2}' "$openbgpd_custom_metadata")
if [[ ! "$PORTABLE93_OPENBGPD_VERSION" =~ ^[0-9]+([.][0-9]+)+$ ]]; then
    printf 'ERROR: build metadata has an invalid OpenBGPD version\n' >&2
    return 1
fi
case "$(awk -F= '$1 == "Allocator_Linkage" {print $2}' "$openbgpd_custom_metadata")" in
    jemalloc) RS_ALLOCATOR=jemalloc ;;
    system) RS_ALLOCATOR=default ;;
    *)
        printf 'ERROR: build metadata has an unsupported allocator\n' >&2
        return 1 ;;
esac
unset openbgpd_custom_metadata
PORTABLE93_BGPD_BIN="$OPENBGPD_CUSTOM_PREFIX/sbin/bgpd"
PORTABLE93_BGPCTL_BIN="$OPENBGPD_CUSTOM_PREFIX/sbin/bgpctl"
