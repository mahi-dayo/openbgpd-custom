# Source via RS_TEST_CONFIG from the OpenBSD lab controller.
: "${OPENBGPD_CUSTOM_PREFIX:?set OPENBGPD_CUSTOM_PREFIX to the native 9.3 build directory}"
openbgpd_custom_lab_config=${OPENBGPD_CUSTOM_LAB_CONFIG:-"$HOME/openbgpd-rs-lab/openbsd/rs-test.env"}
if [[ -r "$openbgpd_custom_lab_config" ]]; then
    source "$openbgpd_custom_lab_config"
fi
unset openbgpd_custom_lab_config

if [[ "$OPENBGPD_CUSTOM_PREFIX" != /* ||
      ! -x "$OPENBGPD_CUSTOM_PREFIX/sbin/bgpd" ||
      ! -x "$OPENBGPD_CUSTOM_PREFIX/sbin/bgpctl" ]] ||
   ! grep -Fxq 'OpenBGPD_Version=9.3' "$OPENBGPD_CUSTOM_PREFIX/BUILD-METADATA.txt"; then
    printf 'ERROR: OpenBSD preset requires a native 9.3 build and an absolute prefix\n' >&2
    return 1
fi
NATIVE93_PREFIX=$OPENBGPD_CUSTOM_PREFIX
RS_ALLOCATOR=default
